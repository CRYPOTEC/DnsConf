{
  "mode": "backtest",
  "env": "demo",
  "poll_interval": 15,
  "candle_limit": 200,
  "state_path": "state/bot_state.json",

  "symbols": [
    { "symbol": "BTCUSDT", "market": "linear", "interval": "60", "leverage": 3 },
    { "symbol": "ETHUSDT", "market": "linear", "interval": "60", "leverage": 3 }
