# Copy to ../.env (i.e. polybot/.env) and fill in. NEVER commit the real .env.

# Required for the LLM strategy (config strategy: "llm")
ANTHROPIC_API_KEY=

# Telegram notifications (optional but recommended).
# Get the token from @BotFather; find the chat id via: python -m polybot telegram-test
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional extra news sources
NEWSAPI_KEY=
TWITTER_BEARER_TOKEN=

# Live trading wallet — leave empty to stay in paper mode.
# Only set this AFTER a positive paper track record and with live_enabled: true.
# POLYMARKET_PK=
