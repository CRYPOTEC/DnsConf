# ─── Мозг бота (LLM) ─────────────────────────────────────────────
# Ключ Anthropic (Claude). Получить: https://console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Модель. По умолчанию haiku (дёшево, быстро, для FAQ — лучший выбор).
# Дороже/умнее: claude-sonnet-4-6  или  claude-opus-4-8
ANTHROPIC_MODEL=claude-haiku-4-5

# ─── Канал: Telegram ─────────────────────────────────────────────
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
# (необязательно) ID чата администратора для срочных уведомлений (узнать: напиши боту @userinfobot)
TELEGRAM_ADMIN_CHAT_ID=

# ─── Composio (выполнение действий: запись в Google Таблицу) ──────
# Твой ключ Composio (ak_...). ВАЖНО: перевыпусти старый, он засветился в чате.
COMPOSIO_API_KEY=ak_...
# Идентификатор сущности (entity / user id), под которым подключён Google Sheets в Composio.
COMPOSIO_USER_ID=vpn-admin

# ─── Google Таблица (куда писать жалобы) ─────────────────────────
# ID таблицы из её URL: docs.google.com/spreadsheets/d/<ВОТ_ЭТОТ_ID>/edit
GOOGLE_SHEET_ID=
# Название листа (вкладки) внутри таблицы
GOOGLE_SHEET_NAME=Жалобы
